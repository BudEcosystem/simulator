    ],
    "type": "object"
   },
   "type": "array"
  },
  "settings": {
   "additionalProperties": {
    "additionalProperties": false,
    "properties": {
     "arg": {
      "type": "string"
     },
     "env": {
      "type": "string"
     },
     "implies": {
      "type": "object"
     },
     "invert": {
      "type": "boolean"
     },
     "json_key": {
      "type": "string"
     },
     "negated_arg": {
      "type": "string"
     },
     "note": {
      "type": "string"
     },
     "transform": {
      "type": "string"
     },
     "unsupported": {
      "type": "boolean"
     },
     "when": {
      "enum": [
       "online"
      ],
      "type": "string"
     }
    },
    "type": "object"
   },
   "propertyNames": {
    "enum": [
     "batch.max_running",
     "batch.prefill_chunk_tokens",
     "context.max_tokens",
     "kv.dtype",
     "lora.max_adapters",
     "lora.max_rank",
     "memory.device_fraction",
     "mm.encoder_cache",
     "mm.limits",
     "mm.text_only",
     "parallel.pipeline",
     "parallel.tensor",
     "prefix_cache.enabled",
     "spec.draft",
     "spec.method",
     "spec.tokens",
     "state.dtype",
     "weights.format",
     "weights.online",
     "weights.variant"
    ]
   },
   "type": "object"
  }
 },
 "title": "Engine-neutral settings v1 (FRD-027 \u00a75.1) and the engine record mapping",
 "type": "object"
}
